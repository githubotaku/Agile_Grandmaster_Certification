// Agile Grandmaster Certification - data model

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// role: "USER" | "ADMIN"
// Kept as a plain string (validated at the application layer, see
// src/lib/constants.ts) rather than a native enum so it stays portable.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  nameEn       String
  nameKo       String?
  passwordHash String
  role         String   @default("USER")
  quizPassed   Boolean  @default(false)
  quizPassedAt DateTime?
  createdAt    DateTime @default(now())

  applications  Application[]
  certificate   Certificate?
  reviewedApps  Application[] @relation("ReviewedBy")
}

// status: "PENDING" | "APPROVED" | "REJECTED"
model Application {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  essay           String
  status          String    @default("PENDING")
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?     @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason String?

  certificate     Certificate?

  @@index([status])
}

model Certificate {
  id            String   @id @default(cuid())
  number        String   @unique
  sequence      Int      @unique
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String   @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  issuedAt      DateTime @default(now())
  issuedById    String?

  @@index([number])
}

// Single row (id = "certificate") used to atomically hand out the next
// sequential certificate number, starting at 1 -> "00000001".
model Counter {
  id    String @id
  value Int    @default(0)
}
