# Supabase Postgres connection strings (Project Settings -> Database).
# DATABASE_URL: the pooled "Transaction" connection (port 6543) — used at runtime.
# DIRECT_URL: the direct connection (port 5432) — used by `prisma migrate`.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Used to sign/verify session cookies. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-a-random-32-byte-base64-string"

# Base URL used to build absolute certificate links (e.g. for LinkedIn sharing).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed data for the first administrator account (used by `npm run db:seed`).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME_EN="Admin"
