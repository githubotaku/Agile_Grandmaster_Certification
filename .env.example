# Local dev: SQLite file. In production (e.g. Vercel), set this to a Turso
# libSQL URL instead, e.g. "libsql://your-db-name.turso.io", and also set
# TURSO_AUTH_TOKEN below (see README "Deploying" section).
DATABASE_URL="file:./dev.db"
TURSO_AUTH_TOKEN=""

# Used to sign/verify session cookies. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-a-random-32-byte-base64-string"

# Base URL used to build absolute certificate links (e.g. for LinkedIn sharing).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed data for the first administrator account (used by `npm run db:seed`).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME_EN="Admin"
